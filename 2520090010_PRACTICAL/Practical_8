#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

void memory_allocation_demo()
{
    printf("=== Part 1: malloc, calloc, realloc, free & Leaks ===\n");

    int *arr_malloc = (int *)malloc(3 * sizeof(int));
    for (int i = 0; i < 3; i++)
    {
        arr_malloc[i] = (i + 1) * 10;
    }
    printf("malloc array:  %d %d %d\n", arr_malloc[0], arr_malloc[1], arr_malloc[2]);

    int *arr_calloc = (int *)calloc(3, sizeof(int));
    printf("calloc zeroed: %d %d %d\n", arr_calloc[0], arr_calloc[1], arr_calloc[2]);

    arr_malloc = (int *)realloc(arr_malloc, 5 * sizeof(int));
    arr_malloc[3] = 40;
    arr_malloc[4] = 50;
    printf("realloc array: %d %d %d %d %d\n", arr_malloc[0], arr_malloc[1], arr_malloc[2], arr_malloc[3], arr_malloc[4]);

    free(arr_malloc);
    free(arr_calloc);
    printf("Freed allocated buffers successfully.\n");

    int *leaked_memory = (int *)malloc(64 * sizeof(int));
    leaked_memory[0] = 999;
    printf("Simulated memory leak: 256 bytes allocated without free().\n\n");
}

void copy_on_write_demo()
{
    printf("=== Part 2: Copy-on-Write (COW) Behavior ===\n");

    size_t size = 1024 * 1024;
    char *shared_data = (char *)malloc(size);
    memset(shared_data, 'A', size);

    printf("Parent allocated 1 MB buffer initialized to 'A'.\n");
    printf("Parent data address: %p, sample char: '%c'\n", (void *)shared_data, shared_data[0]);

    pid_t pid = fork();

    if (pid == 0)
    {
        printf("\n[Child] Before modification (Shared physical frame via COW):\n");
        printf("[Child] Address: %p, sample char: '%c'\n", (void *)shared_data, shared_data[0]);
 
    pid_t pid = fork();
    
    if (pid == 0)
    {
        printf("\n[Child] Before modification (Shared physical frame via COW):\n");
        printf("[Child] Address: %p, sample char: '%c'\n", (void *)shared_data, shared_data[0]);
    
        printf("[Child] Modifying buffer...\n");
        memset(shared_data, 'B', size);

        printf("[Child] After modification (COW duplicate frame allocated):\n");
        printf("[Child] Address: %p, sample char: '%c'\n", (void *)shared_data, shared_data[0]);
    
        free(shared_data);
        exit(0);
    }
    else
    {
        wait(NULL);
        printf("\n[Parent] Child finished.\n");
        printf("[Parent] Value remains unchanged: '%c'\n", shared_data[0]);
        free(shared_data);
    }
}
    
int main()
{
    memory_allocation_demo();
    copy_on_write_demo();
    return 0;
}
