#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int global_initialized = 42;
int global_uninitialized;

void function_code()
{
    return;
}

int main()
{
    static int static_var = 100;
    int stack_var = 10;
    int *heap_var = (int *)malloc(sizeof(int));
    *heap_var = 20;

    printf("=== Process Address Space Layout (PID: %d) ===\n\n", getpid());
    printf("Code / Text Segment:      %p\n", (void *)function_code);
    printf("Data Segment (Init):      %p\n", (void *)&global_initialized);
    printf("BSS Segment (Uninit):     %p\n", (void *)&global_uninitialized);
    printf("Data/BSS (Static):        %p\n", (void *)&static_var);
    printf("Heap Segment:             %p\n", (void *)heap_var);
    printf("Stack Segment:            %p\n", (void *)&stack_var);

    printf("\n=== System Virtual Memory Map Summary ===\n");
    char cmd[128];
    snprintf(cmd, sizeof(cmd), "vmmap -summary %d 2>/dev/null | grep -E 'Stack|malloc|TEXT|DATA'", getpid());
    system(cmd);

    free(heap_var);
    return 0;
}
