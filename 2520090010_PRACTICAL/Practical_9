#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <time.h>
#include <string.h>

#define TEST_FILE "test_large.dat"
#define COPY_SYS "copy_syscall.dat"
#define COPY_LIB "copy_lib.dat"
#define BUFFER_SIZE 4096

void create_test_file()
{
    FILE *fp = fopen(TEST_FILE, "wb");
    char dummy[BUFFER_SIZE];
    memset(dummy, 'A', BUFFER_SIZE);
    for (int i = 0; i < 2000; i++)
    {
        fwrite(dummy, 1, BUFFER_SIZE, fp);
    }
    fclose(fp);
}

void compare_file_io()
{
    printf("=== Part 1: Low-Level Syscalls vs Standard Library ===\n");
    create_test_file();

    clock_t start = clock();
    int src_fd = open(TEST_FILE, O_RDONLY);
    int dst_fd = open(COPY_SYS, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    char buf[BUFFER_SIZE];
    ssize_t bytes_read;

    lseek(src_fd, 0, SEEK_SET);
    while ((bytes_read = read(src_fd, buf, BUFFER_SIZE)) > 0)
    {
        write(dst_fd, buf, bytes_read);
    }
    close(src_fd);
    close(dst_fd);
    clock_t end = clock();
    double time_syscall = ((double)(end - start)) / CLOCKS_PER_SEC;
    printf("Low-Level Syscalls (open/read/write/lseek): %f seconds\n", time_syscall);

    start = clock();
    FILE *src_fp = fopen(TEST_FILE, "rb");
    FILE *dst_fp = fopen(COPY_LIB, "wb");
    size_t n_read;

    while ((n_read = fread(buf, 1, BUFFER_SIZE, src_fp)) > 0)
    {
        fwrite(buf, 1, n_read, dst_fp);
    }
    fclose(src_fp);
    fclose(dst_fp);
    end = clock();
    double time_lib = ((double)(end - start)) / CLOCKS_PER_SEC;
    printf("Standard Library (fopen/fread/fwrite):       %f seconds\n\n", time_lib);

    unlink(TEST_FILE);
    unlink(COPY_SYS);
    unlink(COPY_LIB);
}

void demonstrate_redirection()
{
    printf("=== Part 2: Shell I/O Redirection using dup2() ===\n");

    int saved_stdout = dup(STDOUT_FILENO);
    int saved_stdin = dup(STDIN_FILENO);

    int out_fd = open("redirect_out.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    dup2(out_fd, STDOUT_FILENO);
    close(out_fd);

    printf("This message was redirected to redirect_out.txt via dup2()!");
    fflush(stdout);

    dup2(saved_stdout, STDOUT_FILENO);
    close(saved_stdout);

    printf("Stdout restored to terminal.\n");

    int in_fd = open("redirect_out.txt", O_RDONLY);
    dup2(in_fd, STDIN_FILENO);
    close(in_fd);

    char read_back[128];
    fgets(read_back, sizeof(read_back), stdin);

    dup2(saved_stdin, STDIN_FILENO);
    close(saved_stdin);

    printf("Stdin captured from file: \"%s\"\n", read_back);

    unlink("redirect_out.txt");
}

int main()
{
    compare_file_io();
    demonstrate_redirection();
    return 0;
}
