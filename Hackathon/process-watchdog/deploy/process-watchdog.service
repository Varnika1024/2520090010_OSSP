# Install:  sudo cp deploy/process-watchdog.service /etc/systemd/system/
# Edit User= and the paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now process-watchdog
[Unit]
Description=Linux Process Watchdog and Auto-Restart System
After=network.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/process-watchdog
ExecStart=/usr/bin/python3 /opt/process-watchdog/watchdog.py --config /opt/process-watchdog/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
