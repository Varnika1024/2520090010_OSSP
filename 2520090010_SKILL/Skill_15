#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_TOKENS 32
#define MAX_CMDS 8

typedef struct
{
    char *args[MAX_TOKENS];
    char *input_file;
    char *output_file;
    char *stderr_file;
    int append_out;
    int merge_stderr_to_stdout;
} CommandNode;

void parse_command_segment(char *tokens[], CommandNode *node)
{
    memset(node, 0, sizeof(CommandNode));
    int arg_idx = 0;

    for (int i = 0; tokens[i] != NULL; i++)
    {
        if (strcmp(tokens[i], "<") == 0)
        {
            if (tokens[i + 1])
            {
                node->input_file = tokens[++i];
            }
        }
        else if (strcmp(tokens[i], ">") == 0)
        {
            if (tokens[i + 1])
            {
                node->output_file = tokens[++i];
                node->append_out = 0;
            }
        }
        else if (strcmp(tokens[i], ">>") == 0)
        {
            if (tokens[i + 1])
            {
                node->output_file = tokens[++i];
                node->append_out = 1;
            }
        }
        else if (strcmp(tokens[i], "2>") == 0)
        {
            if (tokens[i + 1])
            {
                node->stderr_file = tokens[++i];
            }
        }
        else if (strcmp(tokens[i], "2>&1") == 0)
        {
            node->merge_stderr_to_stdout = 1;
        }
        else
        {
            node->args[arg_idx++] = tokens[i];
        }
    }
    node->args[arg_idx] = NULL;
}

void apply_redirections(CommandNode *node)
{
    if (node->input_file)
    {
        int in_fd = open(node->input_file, O_RDONLY);
        if (in_fd < 0)
        {
            perror("input redirection failed");
            exit(1);
        }
        dup2(in_fd, STDIN_FILENO);
        close(in_fd);
    }

    if (node->output_file)
    {
        int flags = O_WRONLY | O_CREAT | (node->append_out ? O_APPEND : O_TRUNC);
        int out_fd = open(node->output_file, flags, 0644);
        if (out_fd < 0)
        {
            perror("output redirection failed");
            exit(1);
        }
        dup2(out_fd, STDOUT_FILENO);
        close(out_fd);
    }

    if (node->stderr_file)
    {
        int err_fd = open(node->stderr_file, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (err_fd < 0)
        {
            perror("stderr redirection failed");
            exit(1);
        }
        dup2(err_fd, STDERR_FILENO);
        close(err_fd);
    }

    if (node->merge_stderr_to_stdout)
    {
        dup2(STDOUT_FILENO, STDERR_FILENO);
    }
}

void execute_complex_pipeline(char *raw_tokens[])
{
    CommandNode nodes[MAX_CMDS];
    int num_cmds = 0;

    char *current_segment[MAX_TOKENS];
    int seg_idx = 0;

    for (int i = 0; raw_tokens[i] != NULL; i++)
    {
        if (strcmp(raw_tokens[i], "|") == 0)
        {
            current_segment[seg_idx] = NULL;
            parse_command_segment(current_segment, &nodes[num_cmds++]);
            seg_idx = 0;
        }
        else
        {
            current_segment[seg_idx++] = raw_tokens[i];
        }
    }
    current_segment[seg_idx] = NULL;
    parse_command_segment(current_segment, &nodes[num_cmds++]);

    int pipefds[2 * (num_cmds - 1)];
    for (int i = 0; i < num_cmds - 1; i++)
    {
        if (pipe(pipefds + i * 2) < 0)
        {
            perror("pipe creation failed");
            return;
        }
    }

    pid_t pids[MAX_CMDS];
    for (int i = 0; i < num_cmds; i++)
    {
        pids[i] = fork();
        if (pids[i] == 0)
        {
            if (i > 0)
            {
                dup2(pipefds[(i - 1) * 2], STDIN_FILENO);
            }

            if (i < num_cmds - 1)
            {
                dup2(pipefds[i * 2 + 1], STDOUT_FILENO);
            }

            for (int j = 0; j < 2 * (num_cmds - 1); j++)
            {
                close(pipefds[j]);
            }

            apply_redirections(&nodes[i]);

            execvp(nodes[i].args[0], nodes[i].args);
            perror("execvp failed");
            exit(1);
        }
    }

    for (int i = 0; i < 2 * (num_cmds - 1); i++)
    {
        close(pipefds[i]);
    }

    for (int i = 0; i < num_cmds; i++)
    {
        int status;
        waitpid(pids[i], &status, 0);
    }
}

void display_file(const char *filename)
{
    FILE *fp = fopen(filename, "r");
    if (!fp)
    {
        perror("display_file failed");
        return;
    }
    printf("--- Content of '%s' ---\n", filename);
    char line[256];
    while (fgets(line, sizeof(line), fp))
    {
        printf("  %s", line);
    }
    printf("---------------------------\n\n");
    fclose(fp);
}

int main()
{
    const char *merged_out = "merged_output.txt";
    const char *final_pipeline_out = "pipeline_final.txt";

    unlink(merged_out);
    unlink(final_pipeline_out);

    printf("=== Part 1: Stream Merging (2>&1) into File ===\n\n");

    char *cmd_merge[] = {
        "sh", "-c", "echo Standard Message; ls /non_existent_folder_skill15",
        ">", (char *)merged_out, "2>&1", NULL
    };
    printf("Executing: sh -c ... > merged_output.txt 2>&1\n");
    execute_complex_pipeline(cmd_merge);
    display_file(merged_out);

    printf("=== Part 2: Complex Mixed Pipeline with Redirections ===\n\n");

    char *complex_tokens[] = {
        "printf", "apple\npear\nbanana\norange\npeach\n", "|",
        "grep", "p", "|",
        "sort", "|",
        "tee", (char *)final_pipeline_out,
        NULL
    };

    printf("Executing: printf ... | grep p | sort | tee pipeline_final.txt\n\n");
    execute_complex_pipeline(complex_tokens);
    printf("\nFile Output Validation:\n");
    display_file(final_pipeline_out);

    unlink(merged_out);
    unlink(final_pipeline_out);
    return 0;
}
