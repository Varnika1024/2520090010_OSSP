#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

#define MAX_JOBS 32
#define MAX_CMD_LEN 128

typedef enum
{
    JOB_RUNNING,
    JOB_DONE
} JobState;

typedef struct
{
    int job_id;
    pid_t pid;
    pid_t pgid;
    char command[MAX_CMD_LEN];
    JobState state;
} Job;

Job job_table[MAX_JOBS];
int next_job_id = 1;

void job_table_init()
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        job_table[i].job_id = 0;
        job_table[i].pid = 0;
        job_table[i].pgid = 0;
        job_table[i].state = JOB_DONE;
        job_table[i].command[0] = '\0';
    }
}

int job_add(pid_t pid, pid_t pgid, const char *cmd)
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id == 0)
        {
            job_table[i].job_id = next_job_id++;
            job_table[i].pid = pid;
            job_table[i].pgid = pgid;
            job_table[i].state = JOB_RUNNING;
            strncpy(job_table[i].command, cmd, MAX_CMD_LEN - 1);
            job_table[i].command[MAX_CMD_LEN - 1] = '\0';
            return job_table[i].job_id;
        }
    }
    return -1;
}

void job_table_update_status()
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id != 0 && job_table[i].state == JOB_RUNNING)
        {
            int status;
            pid_t result = waitpid(job_table[i].pid, &status, WNOHANG);
            if (result == job_table[i].pid)
            {
                job_table[i].state = JOB_DONE;
            }
        }
    }
}

void job_table_display()
{
    job_table_update_status();
    printf("--- Active Job Table ---\n");
    printf("%-8s %-8s %-8s %-12s %-20s\n", "JID", "PID", "PGID", "STATE", "COMMAND");
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id != 0)
        {
            const char *state_str = (job_table[i].state == JOB_RUNNING) ? "Running" : "Done";
            printf("[%d]      %-8d %-8d %-12s %s\n",
                   job_table[i].job_id,
                   job_table[i].pid,
                   job_table[i].pgid,
                   state_str,
                   job_table[i].command);
        }
    }
    printf("------------------------\n\n");
}

void job_table_remove_completed()
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id != 0 && job_table[i].state == JOB_DONE)
        {
            printf("[Job Cleanup] Removing completed Job [%d] (PID: %d)\n",
                   job_table[i].job_id, job_table[i].pid);
            job_table[i].job_id = 0;
            job_table[i].pid = 0;
            job_table[i].pgid = 0;
            job_table[i].command[0] = '\0';
        }
    }
}

int is_background_command(char *tokens[])
{
    int i = 0;
    while (tokens[i] != NULL)
    {
        i++;
    }
    if (i > 0 && strcmp(tokens[i - 1], "&") == 0)
    {
        tokens[i - 1] = NULL;
        return 1;
    }
    return 0;
}

void execute_command(char *tokens[], const char *raw_cmd)
{
    int is_bg = is_background_command(tokens);

    pid_t pid = fork();
    if (pid < 0)
    {
        perror("fork failed");
        return;
    }

    if (pid == 0)
    {
        setpgid(0, 0);
        execvp(tokens[0], tokens);
        perror("execvp failed");
        exit(1);
    }
    else
    {
        setpgid(pid, pid);

        if (is_bg)
        {
            int jid = job_add(pid, pid, raw_cmd);
            printf("[Job Created] [%d] %d (Running in background)\n", jid, pid);
            printf("[Prompt] Shell prompt returned immediately.\n\n");
        }
        else
        {
            int status;
            waitpid(pid, &status, 0);
        }
    }
}

int main()
{
    job_table_init();

    printf("=== Part 1: Launching Background Tasks (Non-blocking & Job Table) ===\n\n");

    char *cmd1[] = {"sleep", "2", "&", NULL};
    printf("Submitting: sleep 2 &\n");
    execute_command(cmd1, "sleep 2 &");

    char *cmd2[] = {"sleep", "1", "&", NULL};
    printf("Submitting: sleep 1 &\n");
    execute_command(cmd2, "sleep 1 &");

    printf("Inspecting Job Table immediately after launch:\n");
    job_table_display();

    printf("=== Part 2: State Tracking & Non-blocking Harvesting (waitpid WNOHANG) ===\n\n");

    printf("Main thread sleeping for 1.5 seconds to allow Job [2] to finish...\n\n");
    usleep(1500000);

    printf("Inspecting Job Table after 1.5 seconds:\n");
    job_table_display();

    job_table_remove_completed();
    printf("\nJob Table after purging completed jobs:\n");
    job_table_display();

    printf("Main thread sleeping for another 1 second to allow Job [1] to finish...\n\n");
    usleep(1000000);

    printf("Final Job Table State:\n");
    job_table_display();

    job_table_remove_completed();
    printf("\nFinal Cleared Job Table:\n");
    job_table_display();

    return 0;
}
