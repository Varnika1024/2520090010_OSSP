#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Node {
    char *cmd;
    struct Node *next;
} Node;

void free_history(Node *head) {
    while (head) {
        Node *tmp = head;
        head = head->next;
        free(tmp->cmd);
        free(tmp);
    }
}

void add_history(Node **head, const char *cmd) {
    Node *new_node = malloc(sizeof(Node));
    if (!new_node) exit(1);
    new_node->cmd = strdup(cmd);
    new_node->next = *head;
    *head = new_node;
}

int main() {
    size_t buf_cap = 16;
    char *input = malloc(buf_cap);
    Node *history = NULL;

    while (1) {
        printf("myshell> ");
        fflush(stdout);

        if (getline(&input, &buf_cap, stdin) == -1) break;

        input[strcspn(input, "\n")] = 0;

        if (strlen(input) == 0) continue;

        if (strcmp(input, "exit") == 0 || strcmp(input, "quit") == 0) break;

        if (strcmp(input, "history") == 0) {
            for (Node *curr = history; curr; curr = curr->next)
                printf("  %s\n", curr->cmd);
            continue;
        }

        add_history(&history, input);
        printf("Executing: %s\n", input);
    }

    free(input);
    free_history(history);
    return 0;
}
