#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_TOKENS 16

void parse_redirection(char *tokens[], char **input_file, char **output_file)
{
    *input_file = NULL;
    *output_file = NULL;

    int j = 0;
    for (int i = 0; tokens[i] != NULL; i++)
    {
        if (strcmp(tokens[i], "<") == 0)
        {
            if (tokens[i + 1] != NULL)
            {
                *input_file = tokens[i + 1];
                i++;
            }
        }
        else if (strcmp(tokens[i], ">") == 0)
        {
            if (tokens[i + 1] != NULL)
            {
                *output_file = tokens[i + 1];
                i++;
            }
        }
        else
        {
            tokens[j++] = tokens[i];
        }
    }
    tokens[j] = NULL;
}

void execute_with_redirection(char *tokens[])
{
    char *input_file = NULL;
    char *output_file = NULL;

    parse_redirection(tokens, &input_file, &output_file);

    if (tokens[0] == NULL)
    {
        return;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        perror("fork failed");
        return;
    }

    if (pid == 0)
    {
        if (input_file)
        {
            int in_fd = open(input_file, O_RDONLY);
            if (in_fd < 0)
            {
                perror("input redirection failed");
                exit(1);
            }
            dup2(in_fd, STDIN_FILENO);
            close(in_fd);
        }

        if (output_file)
        {
            int out_fd = open(output_file, O_WRONLY | O_CREAT | O_TRUNC, 0644);
            if (out_fd < 0)
            {
                perror("output redirection failed");
                exit(1);
            }
            dup2(out_fd, STDOUT_FILENO);
            close(out_fd);
        }

        execvp(tokens[0], tokens);
        perror("execvp failed");
        exit(1);
    }
    else
    {
        int status;
        waitpid(pid, &status, 0);
    }
}

void verify_file_content(const char *filename)
{
    FILE *fp = fopen(filename, "r");
    if (!fp)
    {
        perror("fopen verification failed");
        return;
    }
    char line[256];
    printf("Content of '%s':\n", filename);
    while (fgets(line, sizeof(line), fp))
    {
        printf("  %s", line);
    }
    fclose(fp);
}

int main()
{
    printf("=== Part 1: Output Redirection (stdout -> file) ===\n\n");

    char *cmd_out[] = {"printf", "Hello Unix Redirection Engine\\nSecond Line from stdout\\n", ">", "out_test.txt", NULL};
    printf("Executing: printf ... > out_test.txt\n");
    execute_with_redirection(cmd_out);
    verify_file_content("out_test.txt");

    printf("\n=== Part 2: Input Redirection (stdin <- file) ===\n\n");

    char *cmd_in[] = {"wc", "-w", "<", "out_test.txt", NULL};
    printf("Executing: wc -w < out_test.txt\n");
    printf("Word count: ");
    fflush(stdout);
    execute_with_redirection(cmd_in);

    printf("\n=== Part 3: Handling Missing Input Files ===\n\n");

    char *cmd_bad_in[] = {"cat", "<", "missing_file_xyz.txt", NULL};
    printf("Executing: cat < missing_file_xyz.txt\n");
    execute_with_redirection(cmd_bad_in);

    unlink("out_test.txt");
    return 0;
}
