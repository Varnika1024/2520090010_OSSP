#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    } else if (pid == 0) {
        printf("\n[CHILD PROCESS]\n");
        printf("Child PID: %d | Parent PID: %d\n", getpid(), getppid());
        printf("Replacing child process image using execvp()...\n\n");
        
        char *args[] = {"ps", "-f", NULL};
        execvp(args[0], args);

        perror("execvp failed");
        exit(1);
    } else {
        printf("\n[PARENT PROCESS]\n");
        printf("Parent PID: %d | Created Child PID: %d\n", getpid(), pid);
        
        int status;
        wait(&status);
        
        if (WIFEXITED(status)) {
            printf("\n[PARENT PROCESS] Child process finished with exit code %d\n", WEXITSTATUS(status));
        }
    }

    return 0;
}
