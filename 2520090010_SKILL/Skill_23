#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/time.h>
#include <sys/resource.h>
#include <errno.h>

#define MAX_STAGES 8
#define MAX_JOBS 16

typedef struct {
    pid_t pid;
    int job_id;
    char name[32];
} StressJob;

/* Microsecond-precision benchmarking helper */
double get_elapsed_ms(struct timeval start, struct timeval end) {
    return (double)(end.tv_sec - start.tv_sec) * 1000.0 +
           (double)(end.tv_usec - start.tv_usec) / 1000.0;
}

/* Part 1: Deep 5-stage pipeline benchmark & stability evaluation */
void run_large_pipeline_benchmark() {
    printf("=== Part 1: Large Multi-Stage Pipeline Execution & Timing ===\n\n");

    /* Pipeline definition: seq 100000 | grep 5 | grep 0 | sort -n | wc -l */
    char *stages[5][4] = {
        {"seq", "100000", NULL},
        {"grep", "5", NULL},
        {"grep", "0", NULL},
        {"sort", "-n", NULL},
        {"wc", "-l", NULL}
    };
    int num_stages = 5;
    int pipefds[2 * (num_stages - 1)];

    struct timeval t_start, t_end;
    gettimeofday(&t_start, NULL);

    for (int i = 0; i < num_stages - 1; i++) {
        if (pipe(pipefds + i * 2) < 0) {
            perror("pipe allocation failed");
            return;
        }
    }

    pid_t pids[5];
    for (int i = 0; i < num_stages; i++) {
        pids[i] = fork();
        if (pids[i] < 0) {
            perror("fork failed during pipeline");
            return;
        }

        if (pids[i] == 0) {
            if (i > 0) {
                dup2(pipefds[(i - 1) * 2], STDIN_FILENO);
            }
            if (i < num_stages - 1) {
                dup2(pipefds[i * 2 + 1], STDOUT_FILENO);
            }

            for (int j = 0; j < 2 * (num_stages - 1); j++) {
                close(pipefds[j]);
            }

            execvp(stages[i][0], stages[i]);
            perror("execvp failed");
            exit(127);
        }
    }

    for (int i = 0; i < 2 * (num_stages - 1); i++) {
        close(pipefds[i]);
    }

    int pipeline_failed = 0;
    for (int i = 0; i < num_stages; i++) {
        int status;
        waitpid(pids[i], &status, 0);
        if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
            pipeline_failed = 1;
        }
    }

    gettimeofday(&t_end, NULL);
    double elapsed = get_elapsed_ms(t_start, t_end);

    printf("Pipeline: seq 100000 | grep 5 | grep 0 | sort -n | wc -l\n");
    printf("Execution Status: %s\n", pipeline_failed ? "FAIL" : "STABLE & COMPLETE");
    printf("Pipeline Latency: %.2f ms\n\n", elapsed);
}

/* Part 2: Concurrent process scaling & resource usage monitor */
void run_stress_job_monitor() {
    printf("=== Part 2: Concurrent Job Saturation & Resource Usage ===\n\n");

    StressJob jobs[MAX_JOBS];
    int job_count = 8;

    struct timeval t_start, t_end;
    gettimeofday(&t_start, NULL);

    for (int i = 0; i < job_count; i++) {
        jobs[i].job_id = i + 1;
        snprintf(jobs[i].name, sizeof(jobs[i].name), "worker_%d", i + 1);

        pid_t pid = fork();
        if (pid == 0) {
            /* Simulated bounded worker task */
            usleep(150000);
            exit(0);
        }
        jobs[i].pid = pid;
    }

    printf("Spawned %d concurrent child tasks successfully.\n", job_count);

    int all_passed = 1;
    for (int i = 0; i < job_count; i++) {
        int status;
        waitpid(jobs[i].pid, &status, 0);
        if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
            all_passed = 0;
        }
    }

    gettimeofday(&t_end, NULL);
    double elapsed = get_elapsed_ms(t_start, t_end);

    struct rusage usage;
    getrusage(RUSAGE_CHILDREN, &usage);

    printf("All concurrent child tasks reaped.\n");
    printf("Concurrent Execution Wall Time: %.2f ms\n", elapsed);
    printf("Resource Metrics (getrusage child cumulative):\n");
    printf("  User CPU Time:    %ld.%06d s\n", (long)usage.ru_utime.tv_sec, (int)usage.ru_utime.tv_usec);
    printf("  System CPU Time:  %ld.%06d s\n", (long)usage.ru_stime.tv_sec, (int)usage.ru_stime.tv_usec);
    printf("  Peak Resident RSS:%ld KB\n", (long)usage.ru_maxrss / 1024);
    printf("Job Concurrency Health: %s\n\n", all_passed ? "PASS (Zero Zombies / Zero Leaks)" : "FAIL");
}

/* Part 3: Architecture documentation & system call call-graph */
void print_architecture_documentation() {
    printf("=== Part 3: POSIX Shell Subsystem Architecture Reference ===\n\n");
    printf("Execution Flow Diagram:\n");
    printf("  [User Input Line]\n");
    printf("         |\n");
    printf("         v\n");
    printf("  [Tokenizer & Syntax Parser] ---> (Traps ERR_EMPTY_PIPE, ERR_MISSING_REDIRECT)\n");
    printf("         |\n");
    printf("         v\n");
    printf("  [Pipeline Allocator] ---------> pipe() array configured [2 * (N-1) fds]\n");
    printf("         |\n");
    printf("         v\n");
    printf("  [Process Dispatcher] ---------> fork() -> setpgid() leader election\n");
    printf("         |                               |\n");
    printf("         +-- Parent Shell                +-- Child Subprocess\n");
    printf("         |   - tcsetpgrp() [FG]          |   - dup2() pipes / redirection\n");
    printf("         |   - waitpid() [WUNTRACED]     |   - signal() SIG_DFL\n");
    printf("         |   - job_table_update()        |   - execvp()\n");
    printf("         v\n");
    printf("  [State Synchronizer] ---------> sigaction(SIGINT, SIGTSTP, SA_RESTART)\n\n");
    printf("Primary System Call Specifications:\n");
    printf("  * pipe()     : Allocates unidirectional data channels between stage pairs.\n");
    printf("  * dup2()     : Replaces standard descriptors (0, 1, 2) atomically.\n");
    printf("  * setpgid()  : Decouples shell session from background/foreground job groups.\n");
    printf("  * tcsetpgrp(): Arbitrates controlling terminal hardware access.\n");
    printf("  * waitpid()  : Harvests status codes non-blocking (WNOHANG) or traced.\n");
    printf("  * getrusage(): Monitors kernel page faults and CPU utilisation counters.\n\n");
}

int main() {
    run_large_pipeline_benchmark();
    run_stress_job_monitor();
    print_architecture_documentation();
    return 0;
}
