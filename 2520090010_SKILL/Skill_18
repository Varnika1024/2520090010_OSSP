#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>
#include <signal.h>

#define MAX_JOBS 16
#define MAX_CMD_LEN 128

typedef enum
{
    JOB_RUNNING,
    JOB_STOPPED,
    JOB_DONE
} JobState;

typedef struct
{
    int job_id;
    pid_t pid;
    pid_t pgid;
    char command[MAX_CMD_LEN];
    JobState state;
} Job;

Job job_table[MAX_JOBS];
int next_job_id = 1;

void job_table_init()
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        job_table[i].job_id = 0;
        job_table[i].pid = 0;
        job_table[i].pgid = 0;
        job_table[i].state = JOB_DONE;
        job_table[i].command[0] = '\0';
    }
}

int job_add(pid_t pid, pid_t pgid, const char *cmd, JobState state)
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id == 0)
        {
            job_table[i].job_id = next_job_id++;
            job_table[i].pid = pid;
            job_table[i].pgid = pgid;
            job_table[i].state = state;
            strncpy(job_table[i].command, cmd, MAX_CMD_LEN - 1);
            job_table[i].command[MAX_CMD_LEN - 1] = '\0';
            return job_table[i].job_id;
        }
    }
    return -1;
}

Job *job_find_by_id(int jid)
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id == jid)
        {
            return &job_table[i];
        }
    }
    return NULL;
}

void job_table_update()
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id != 0 && job_table[i].state != JOB_DONE)
        {
            int status;
            pid_t res = waitpid(job_table[i].pid, &status, WNOHANG | WUNTRACED | WCONTINUED);
            if (res == job_table[i].pid)
            {
                if (WIFEXITED(status) || WIFSIGNALED(status))
                {
                    job_table[i].state = JOB_DONE;
                }
                else if (WIFSTOPPED(status))
                {
                    job_table[i].state = JOB_STOPPED;
                }
                else if (WIFCONTINUED(status))
                {
                    job_table[i].state = JOB_RUNNING;
                }
            }
        }
    }
}

void builtin_jobs()
{
    job_table_update();
    printf("--- Current Job Table ---\n");
    printf("%-8s %-8s %-8s %-12s %-20s\n", "JID", "PID", "PGID", "STATUS", "COMMAND");
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (job_table[i].job_id != 0)
        {
            const char *status_str = "Running";
            if (job_table[i].state == JOB_STOPPED)
            {
                status_str = "Stopped";
            }
            else if (job_table[i].state == JOB_DONE)
            {
                status_str = "Done";
            }

            printf("[%d]      %-8d %-8d %-12s %s\n",
                   job_table[i].job_id,
                   job_table[i].pid,
                   job_table[i].pgid,
                   status_str,
                   job_table[i].command);
        }
    }
    printf("-------------------------\n\n");
}

int builtin_bg(int jid)
{
    job_table_update();
    Job *job = job_find_by_id(jid);
    if (!job)
    {
        printf("bg: job [%d] not found\n", jid);
        return 1;
    }

    if (job->state != JOB_STOPPED)
    {
        printf("bg: job [%d] already running in background\n", jid);
        return 0;
    }

    if (kill(-job->pgid, SIGCONT) < 0)
    {
        perror("kill SIGCONT failed");
        return 1;
    }

    job->state = JOB_RUNNING;
    printf("[bg] Resumed Job [%d] in background: %s &\n", job->job_id, job->command);
    return 0;
}

void test_signal_masking_and_delivery()
{
    printf("--- Signal Delivery and Masking Verification ---\n");

    sigset_t new_mask, old_mask, pending;
    sigemptyset(&new_mask);
    sigaddset(&new_mask, SIGUSR1);

    if (sigprocmask(SIG_BLOCK, &new_mask, &old_mask) < 0)
    {
        perror("sigprocmask block failed");
        return;
    }
    printf("[Signal Mask] SIGUSR1 blocked in caller thread.\n");

    printf("[Signal Send] Delivering self-directed SIGUSR1...\n");
    raise(SIGUSR1);

    sigpending(&pending);
    if (sigismember(&pending, SIGUSR1))
    {
        printf("[Signal Status] Verified: SIGUSR1 is currently blocked and pending.\n");
    }

    signal(SIGUSR1, SIG_IGN);
    if (sigprocmask(SIG_SETMASK, &old_mask, NULL) < 0)
    {
        perror("sigprocmask restore failed");
        return;
    }
    printf("[Signal Mask] Restored original signal mask; pending SIGUSR1 cleared.\n\n");
}

int main()
{
    signal(SIGTTOU, SIG_IGN);
    signal(SIGTTIN, SIG_IGN);

    job_table_init();

    printf("=== Part 1: Signal Masking, Delivery & Process Group Exploration ===\n\n");
    test_signal_masking_and_delivery();

    printf("=== Part 2: Stopped Job Resumption & Background Recovery (bg) ===\n\n");

    pid_t pid = fork();
    if (pid == 0)
    {
        setpgid(0, 0);
        char *cmd[] = {"sleep", "2", NULL};
        execvp(cmd[0], cmd);
        perror("execvp failed");
        exit(1);
    }

    setpgid(pid, pid);
    job_add(pid, pid, "sleep 2", JOB_RUNNING);

    printf("Launched job with PID: %d. Sending SIGSTOP to suspend it...\n", pid);
    kill(-pid, SIGSTOP);

    int status;
    waitpid(pid, &status, WUNTRACED);
    builtin_jobs();

    printf("Executing: bg 1\n");
    builtin_bg(1);
    builtin_jobs();

    printf("Waiting 2.5 seconds for resumed background job to complete...\n\n");
    usleep(2500000);

    builtin_jobs();

    return 0;
}
